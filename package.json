{
  "name": "worldsimseed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small deterministic simulation runtime for data-defined worlds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yo4e/WorldSimSeed.git"
  },
  "homepage": "https://github.com/yo4e/WorldSimSeed#readme",
  "bugs": {
    "url": "https://github.com/yo4e/WorldSimSeed/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs",
    "schemas",
    "examples"
  ],
  "bin": {
    "worldsimseed": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./spec": {
      "types": "./dist/src/spec/index.d.ts",
      "import": "./dist/src/spec/index.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "import": "./dist/src/core/index.js"
    },
    "./runner": {
      "types": "./dist/src/runner/index.d.ts",
      "import": "./dist/src/runner/index.js"
    },
    "./web": {
      "types": "./dist/src/web/index.d.ts",
      "import": "./dist/src/web/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:browser": "npm run build && playwright test",
    "benchmark:release": "npm run build && node --expose-gc scripts/release-benchmark.mjs",
    "package:check": "npm run build && npm pack --dry-run",
    "demo": "npm run build && node dist/src/cli.js run examples/talent-luck.world.yaml --seed 42",
    "demo:batch": "npm run build && node dist/src/cli.js experiment examples/talent-luck.smoke.experiment.yaml"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ajv": "^8.17.1",
    "typescript": "^5.8.3"
  }
}
